NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://athena:athena@localhost:5432/athena

# Generate two strong secrets (≥32 chars). e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-me-with-48-bytes-base64-or-similar-secret-here
JWT_REFRESH_SECRET=replace-me-with-a-different-48-bytes-base64-secret-here

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:3000

# Used to seed sample knowledge documents on workspace creation.
KNOWLEDGE_URL=http://localhost:4010

# Optional — enables instant cross-process cache invalidation to the gateway.
REDIS_URL=redis://localhost:6379

# Optional — production error tracking. Errors logged to stdout when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

LOG_LEVEL=info
