{
  "name": "@athena/realtime-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "WebSocket ingress: audio → STT → orchestrator → persisted suggestions. PRD F2, F3.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "env -u ANTHROPIC_API_KEY -u OPENAI_API_KEY -u DEEPGRAM_API_KEY tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@athena/auth": "workspace:*",
    "@athena/db": "workspace:*",
    "@athena/policies": "workspace:*",
    "@athena/sdk-embeddings": "workspace:*",
    "@athena/sdk-llm": "workspace:*",
    "@athena/sdk-stt": "workspace:*",
    "@athena/shared-types": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  }
}
