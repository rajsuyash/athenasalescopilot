NODE_ENV=development
PORT=4040
HOST=0.0.0.0

DATABASE_URL=postgresql://athena:athena@localhost:5432/athena

# Same JWT secret as api / knowledge-service / orchestrator-service / postcall-service.
JWT_ACCESS_SECRET=replace-with-the-same-secret-as-services-api-env-here-please

# STT
STT_PROVIDER=auto         # auto = deepgram if DEEPGRAM_API_KEY set, else mock
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Embeddings (used by in-process retrieval)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=256
OPENAI_API_KEY=

# LLM (Stage C grounded answer)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

MIN_DISPLAY_CONFIDENCE=0.5
URGENCY_THRESHOLD=0.5

IDLE_TIMEOUT_MS=120000
MAX_PENDING_SEGMENTS=200

# Auto-recap on session end (Stage D postcall service)
POSTCALL_URL=http://localhost:4030
API_URL=http://localhost:4000
AUTO_RECAP=true
AUTO_END_MEETING=true

# Optional — subscribes to api's cache.invalidate channel so script publishes
# flush the in-memory grounding cache instantly.
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
