NODE_ENV=development
PORT=4030
HOST=0.0.0.0

DATABASE_URL=postgresql://athena:athena@localhost:5432/athena

# Same JWT secret as api / knowledge-service / orchestrator-service.
JWT_ACCESS_SECRET=replace-with-the-same-secret-as-services-api-env-here-please

LLM_PROVIDER=auto         # auto = anthropic if ANTHROPIC_API_KEY set, else mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

DEFAULT_FRAMEWORK=MEDDIC  # MEDDIC | BANT | SPICED
RECAP_DEADLINE_MS=60000

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
