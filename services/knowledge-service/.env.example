NODE_ENV=development
PORT=4010
HOST=0.0.0.0

# Same DB as api
DATABASE_URL=postgresql://athena:athena@localhost:5432/athena

# Same JWT secret as api so we share auth
JWT_ACCESS_SECRET=replace-with-the-same-secret-as-services-api-env-here-please

# Embeddings
EMBEDDING_PROVIDER=auto       # auto = openai if OPENAI_API_KEY set, else deterministic
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=256       # must match the migration's vector(N)

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
