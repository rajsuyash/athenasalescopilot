NODE_ENV=development
PORT=4050
HOST=0.0.0.0

DATABASE_URL=postgresql://athena:athena@localhost:5432/athena

# Same JWT secret as api / knowledge-service / orchestrator-service / postcall-service / realtime-gateway.
JWT_ACCESS_SECRET=replace-with-the-same-secret-as-services-api-env-here-please

# Background sweep interval in ms. Set to 0 to disable (manual trigger only).
SWEEP_INTERVAL_MS=3600000

# Cap deletions per resource per workspace per sweep tick.
BATCH_SIZE=1000

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
