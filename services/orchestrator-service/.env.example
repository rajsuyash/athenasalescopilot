NODE_ENV=development
PORT=4020
HOST=0.0.0.0

DATABASE_URL=postgresql://athena:athena@localhost:5432/athena

# Same JWT secret as api + knowledge-service.
JWT_ACCESS_SECRET=replace-with-the-same-secret-as-services-api-env-here-please

EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=256
OPENAI_API_KEY=

LLM_PROVIDER=auto             # auto = anthropic if ANTHROPIC_API_KEY set, else mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

MIN_DISPLAY_CONFIDENCE=0.5
URGENCY_THRESHOLD=0.5

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
