{
  "manifest_version": 3,
  "name": "Athena Companion",
  "short_name": "Athena",
  "version": "0.1.17",
  "description": "Real-time sales coach for Google Meet. Captures call audio, transcribes, and surfaces grounded answers in the Meet tab.",
  "author": "Athena",
  "homepage_url": "https://athena-admin-web-production.up.railway.app",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://athena-api-production-aa5b.up.railway.app/*",
    "https://athena-realtime-production.up.railway.app/*",
    "wss://athena-realtime-production.up.railway.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://athena-api-production-aa5b.up.railway.app https://athena-realtime-production.up.railway.app wss://athena-realtime-production.up.railway.app;"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Athena Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
