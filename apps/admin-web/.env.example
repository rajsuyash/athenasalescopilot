NODE_ENV=development

# Backend service URLs (server-side only — proxy targets).
ATHENA_API_URL=http://localhost:4000
ATHENA_KNOWLEDGE_URL=http://localhost:4010
ATHENA_ORCHESTRATOR_URL=http://localhost:4020
ATHENA_POSTCALL_URL=http://localhost:4030
ATHENA_RETENTION_URL=http://localhost:4050
ATHENA_ANALYTICS_URL=http://localhost:4060
ATHENA_BILLING_URL=http://localhost:4070

# Cookie name + secret for httpOnly session storage. Production should rotate this.
ATHENA_COOKIE_SECRET=replace-with-a-32-byte-random-string-please-thanks
