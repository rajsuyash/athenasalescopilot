{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm --filter @athena/admin-web... build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @athena/admin-web start -- -p $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 30
  }
}
