# Production environment for docker-compose.prod.yml. Copy to .env and fill in.
# Lines tagged REQUIRED must be set; the rest enable optional features.

# REQUIRED — public hostname (no scheme). Caddy auto-issues a Let's Encrypt cert.
ATHENA_DOMAIN=athena.example.com

# REQUIRED — strong DB password.
POSTGRES_PASSWORD=replace-with-strong-32-char-password

# REQUIRED — JWT signing keys, ≥32 chars each. Generate with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=replace-with-48-bytes-base64-secret
JWT_REFRESH_SECRET=replace-with-different-48-bytes-base64-secret

# Optional — without these the service falls back to mock providers (suggestions
# still flow but quality drops to placeholder text).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Optional — Sentry. Errors logged to stdout when blank.
SENTRY_DSN=

# Optional — Stripe live mode. Leave blank for the launch-day mock plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
