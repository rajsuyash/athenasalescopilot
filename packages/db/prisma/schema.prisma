// Athena database schema. Source of truth is PRD §5.
// Hard rule: every domain table has workspace_id (PRD F10). Only `users` is global.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector, pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity (global)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  name          String
  passwordHash  String?  @map("password_hash")
  globalStatus  String   @default("active") @map("global_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships   UserWorkspaceMembership[]
  hostedMeetings Meeting[]                @relation("MeetingHost")
  auditLogs     AuditLog[]
  feedback      SuggestionFeedback[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant root + membership
// ─────────────────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  planTier  String   @default("free") @map("plan_tier")
  region    String   @default("us")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         UserWorkspaceMembership[]
  teams               Team[]
  meetings            Meeting[]
  transcriptSegments  TranscriptSegment[]
  suggestions         Suggestion[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  scriptCollections   ScriptCollection[]
  answerTemplates     AnswerTemplate[]
  auditLogs           AuditLog[]
  retentionPolicies   RetentionPolicy[]
  invites             Invite[]
  bmc                 WorkspaceBmc?

  @@map("workspaces")
}

/// Per-workspace Business Model Canvas. 1:1 with Workspace. Source for the
/// auto-script-generator (Block Q). Stored as a single JSONB blob so the
/// 10-section bmc-builder skill can evolve without a schema migration; if we
/// later need to filter by, say, `niche`, add a generated column.
model WorkspaceBmc {
  workspaceId String   @id @map("workspace_id") @db.Uuid
  /// Object keyed by BMC section: passion, niche, problem, usp, mvp,
  /// mechanism, message, channel, pricing, delivery. Section values are
  /// free-form structured text the bmc-builder skill produces.
  data        Json
  /// 'pdf' | 'interactive' | 'manual' — drives audit + UX hints.
  sourceType  String   @map("source_type")
  /// Bumped on every full re-publish; used to invalidate downstream caches.
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_bmc")
}

model UserWorkspaceMembership {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String
  teamId      String?  @map("team_id") @db.Uuid
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("user_workspace_memberships")
}

model Team {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  name         String
  parentTeamId String?  @map("parent_team_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentTeam  Team?                     @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  childTeams  Team[]                    @relation("TeamHierarchy")
  memberships UserWorkspaceMembership[]

  @@index([workspaceId])
  @@map("teams")
}

model Invite {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  email       String
  role        String
  teamId      String?  @map("team_id") @db.Uuid
  invitedBy   String   @map("invited_by") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("invites")
}

model RefreshToken {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([workspaceId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Meetings + realtime
// ─────────────────────────────────────────────────────────────────────────────

model Meeting {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  hostUserId         String    @map("host_user_id") @db.Uuid
  externalPlatform   String    @map("external_platform")
  externalMeetingId  String    @map("external_meeting_id")
  title              String?
  startedAt          DateTime? @map("started_at")
  endedAt            DateTime? @map("ended_at")
  status             String    @default("ready")
  consentMode        String    @default("rep_only") @map("consent_mode")
  retentionPolicyId  String?   @map("retention_policy_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host               User                @relation("MeetingHost", fields: [hostUserId], references: [id])
  retentionPolicy    RetentionPolicy?    @relation(fields: [retentionPolicyId], references: [id])
  sessions           MeetingSession[]
  transcriptSegments TranscriptSegment[]
  turns              Turn[]
  intentEvents       IntentEvent[]
  suggestions        Suggestion[]
  summary            MeetingSummary?

  @@index([workspaceId, startedAt])
  @@index([workspaceId, hostUserId])
  @@map("meetings")
}

model MeetingSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String    @map("meeting_id") @db.Uuid
  deviceId  String    @map("device_id")
  status    String    @default("starting")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_sessions")
}

model TranscriptSegment {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  meetingId    String  @map("meeting_id") @db.Uuid
  speakerType  String  @map("speaker_type")
  speakerLabel String  @map("speaker_label")
  text         String
  startMs      Int     @map("start_ms")
  endMs        Int     @map("end_ms")
  confidence   Float
  sourceType   String  @map("source_type")
  language     String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([workspaceId, meetingId, startMs])
  @@map("transcript_segments")
}

model Turn {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  speakerType String   @map("speaker_type")
  startMs     Int      @map("start_ms")
  endMs       Int      @map("end_ms")
  finalizedAt DateTime @default(now()) @map("finalized_at")

  meeting      Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  intentEvents IntentEvent[]
  suggestions  Suggestion[]

  @@index([meetingId, startMs])
  @@map("turns")
}

model IntentEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId            String   @map("meeting_id") @db.Uuid
  turnId               String   @map("turn_id") @db.Uuid
  categories           String[] @db.Text
  stageSignal          String   @map("stage_signal")
  urgencyScore         Float    @map("urgency_score")
  interruptionPriority Float    @map("interruption_priority")
  confidence           Float
  modelVersion         String   @map("model_version")
  detectedAt           DateTime @default(now()) @map("detected_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  turn    Turn    @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([meetingId, detectedAt])
  @@map("intent_events")
}

model Suggestion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  meetingId       String   @map("meeting_id") @db.Uuid
  turnId          String   @map("turn_id") @db.Uuid
  suggestionType  String   @map("suggestion_type")
  answerText      String?  @map("answer_text")
  followupText    String?  @map("followup_text")
  confidenceScore Float    @map("confidence_score")
  priorityScore   Float    @map("priority_score")
  sourceChunkIds  String[] @map("source_chunk_ids") @db.Uuid
  policyVersion   String   @map("policy_version")
  rationale       String?
  generatedAt     DateTime @default(now()) @map("generated_at")
  displayedAt     DateTime? @map("displayed_at")
  dismissedAt     DateTime? @map("dismissed_at")
  acceptedSignal  String?  @map("accepted_signal")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  turn      Turn                 @relation(fields: [turnId], references: [id], onDelete: Cascade)
  feedback  SuggestionFeedback[]
  flags     SuggestionFlag[]
  comments  SuggestionComment[]

  @@index([workspaceId, meetingId, generatedAt])
  @@map("suggestions")
}

model SuggestionFeedback {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suggestionId String   @map("suggestion_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  feedback     String
  action       String?
  createdAt    DateTime @default(now()) @map("created_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([suggestionId])
  @@map("suggestion_feedback")
}

/// Manager-applied flag on a suggestion. Used for the enablement review queue
/// and call-coaching workflows. PRD F13.
model SuggestionFlag {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  suggestionId String   @map("suggestion_id") @db.Uuid
  flaggedBy    String   @map("flagged_by") @db.Uuid
  /// risky | wrong | example | revisit
  reason       String
  notes        String?
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime @default(now()) @map("created_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resolvedAt])
  @@index([suggestionId])
  @@map("suggestion_flags")
}

/// Threaded comment on a suggestion. Manager and host rep can post.
model SuggestionComment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  suggestionId String   @map("suggestion_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId, createdAt])
  @@map("suggestion_comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge + scripts
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  category    String
  status      String   @default("processing")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  KnowledgeDocumentVersion[]

  @@index([workspaceId, status])
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  version      Int
  contentHash  String   @map("content_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   KnowledgeChunk[]

  @@unique([documentId, version])
  @@unique([documentId, contentHash])
  @@map("knowledge_document_versions")
}

/// Vector dimension is set per embedding model; default 1536. See docs/decisions/0003-embedding-model.md (TBD).
model KnowledgeChunk {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  documentVersionId String   @map("document_version_id") @db.Uuid
  chunkText         String   @map("chunk_text")
  chunkOrder        Int      @map("chunk_order")
  tagsJson          Json     @map("tags_json")
  visibilityScope   String   @default("workspace") @map("visibility_scope")
  language          String
  active            Boolean  @default(true)
  // Embedding column managed by raw SQL (pgvector). MUST be declared as
  // Unsupported here so `prisma db push --accept-data-loss` does not drop it
  // when reconciling the schema (which would silently NULL all stored vectors
  // on every redeploy and break retrieval). See packages/db/manual-sql/01_pgvector_chunk_embedding.sql.
  embedding         Unsupported("vector(256)")? @map("embedding")

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentVersion KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
  @@map("knowledge_chunks")
}

model ScriptCollection {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  name             String
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions       ScriptVersion[]  @relation("CollectionVersions")
  currentVersion ScriptVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@index([workspaceId])
  @@map("script_collections")
}

model ScriptVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  version      Int
  status       String   @default("draft")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime @default(now()) @map("created_at")

  collection           ScriptCollection  @relation("CollectionVersions", fields: [collectionId], references: [id], onDelete: Cascade)
  asCurrentForCollection ScriptCollection? @relation("CurrentVersion")
  blocks               ScriptStageBlock[]

  @@unique([collectionId, version])
  @@map("script_versions")
}

model ScriptStageBlock {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String  @map("version_id") @db.Uuid
  stage     String
  persona   String?
  language  String  @default("en-US")
  bodyMd    String  @map("body_md")
  ordering  Int     @default(0)

  version ScriptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("script_stage_blocks")
}

model AnswerTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  category       String
  body           String
  sourceChunkIds String[] @map("source_chunk_ids") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, category])
  @@map("answer_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// Post-call + audit + retention
// ─────────────────────────────────────────────────────────────────────────────

model MeetingSummary {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId     String   @unique @map("meeting_id") @db.Uuid
  summary       String
  objectionsJson Json    @map("objections_json")
  nextStepsJson Json     @map("next_steps_json")
  followupEmail Json?    @map("followup_email")
  crmSuggestionsJson Json? @map("crm_suggestions_json")
  adherenceJson Json?    @map("adherence_json")
  lowSignal     Boolean  @default(false) @map("low_signal")
  createdAt     DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_summaries")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  metadataJson  Json     @default("{}") @map("metadata_json")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@map("audit_logs")
}

model RetentionPolicy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  transcriptDays  Int      @default(30) @map("transcript_days")
  audioDays       Int      @default(0) @map("audio_days")
  summaryDays     Int      @default(365) @map("summary_days")
  auditDays       Int      @default(365) @map("audit_days")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meetings  Meeting[]

  @@index([workspaceId])
  @@map("retention_policies")
}

/// Per-stage latency events emitted by the realtime gateway. Used by
/// analytics-service to compute P50/P95/P99 against PRD §7 budgets.
/// Cheap to write, indexed for fast percentile queries.
model LatencyEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  meetingId   String?  @map("meeting_id") @db.Uuid
  stage       String   // "transcript_final" | "intent" | "retrieval" | "suggestion" | "coach_total"
  latencyMs   Int      @map("latency_ms")
  degraded    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, stage, createdAt])
  @@map("latency_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing (PRD F16) — Stripe-mirrored. One billing account per workspace.
// ─────────────────────────────────────────────────────────────────────────────

model BillingAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String   @unique @map("workspace_id") @db.Uuid
  stripeCustomerId  String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  planTier          String   @default("free") @map("plan_tier")        // free | pro | enterprise
  status            String   @default("active")                          // active | trialing | past_due | canceled
  seats             Int      @default(1)
  /// Soft cap on meeting hours per period. -1 = unlimited.
  meetingHourLimit  Int      @default(50) @map("meeting_hour_limit")
  currentPeriodEnd  DateTime? @map("current_period_end")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  usageCounters     UsageCounter[]

  @@map("billing_accounts")
}

/// In-app notification (PRD F13 — flagged suggestion alerts; F16 — billing
/// near-limit). Workspace-scoped, addressed to a single user. The macOS
/// overlay polls /v1/notifications/unread while a session is live.
model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// "suggestion.flagged" | "suggestion.commented" | "billing.warn"
  kind        String
  title       String
  body        String
  /// Optional deep-link path within the admin web (e.g. /meetings/<id>).
  linkPath    String?  @map("link_path")
  payload     Json     @default("{}")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

/// Per-period usage counters. One row per (workspace, period_start, kind).
/// kind ∈ { meeting_hours, mar, knowledge_chunks }.
model UsageCounter {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  billingAccountId String  @map("billing_account_id") @db.Uuid
  kind            String
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  value           Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, periodStart])
  @@map("usage_counters")
}
