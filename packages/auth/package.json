{
  "name": "@athena/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Single-source JWT auth: expired-vs-invalid classification, Fastify auth plugin, and WS token verification. The ONLY place token errors are classified — services import this instead of hand-copying lib/auth.ts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@athena/policies": "workspace:*",
    "@athena/shared-types": "workspace:*",
    "@fastify/jwt": "^9.0.1",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "fastify": "^5.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
