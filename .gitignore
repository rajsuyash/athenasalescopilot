*.swo
*~

# Local Claude state (keep config, ignore runtime)
.claude/cache/
.claude/state/
.claude/logs/
.claude/sessions/
.claude/local/
.claude/settings.local.json

# gstack working dir — security reports, telemetry, learnings, checkpoints.
# /cso writes findings (with file:line vuln locations + exploit scenarios) here;
# committing them publishes a roadmap of unpatched issues to anyone reading the repo.
.gstack/

# /uat-runner artifacts: plans, reports, raw subagent outputs, screenshots.
# Same reasoning as .gstack/ — UAT reports include exploit-adjacent findings
# and per-case repro steps. Keep local.
.claude/uat/
**/.uat-tmp/

# Database / docker volumes
data/
pgdata/
.docker-data/

# Audio capture artifacts (never commit raw audio)
*.wav
*.pcm
*.m4a
*.mp3
audio-samples/
.claude/screenshots/
